# Copy this file to .env and fill in real values.
# Never commit .env. Keys here are placeholders only.

# --- OpenAI / Google AI ---
OPENAI_API_KEY=sk-proj-xxxx
GOOGLE_API_KEY=AIzaxxxx

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=000000:xxxxxxxxxxxxxxxxxxxxxxx
ADMIN_TG_ID=0

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJ...                            # anon key (mobile + legacy bot path)
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # backend writes
SUPABASE_JWT_SECRET=your-jwt-secret-here       # HS256 secret for verifying mobile JWTs
USER_EMAIL=service@example.com                 # legacy bot path login
USER_PASSWORD=replace-me

# Optional Postgres direct connection (for bot/migrate.py)
DATABASE_URL=postgres://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Redis (arq queue + rate limits + idempotency) ---
REDIS_URL=redis://localhost:6379

# --- Internal bot/backend HMAC ---
INTERNAL_AUTH_SECRET=                          # openssl rand -hex 32
INTERNAL_AUTH_SECRET_NEXT=                     # set during rotation only

# --- iOS push (APNs) ---
APNS_AUTH_KEY_BASE64=                          # base64 of the .p8 file
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.pandasolve.client
APNS_SANDBOX=false

# --- Android push (FCM) ---
FCM_SERVICE_ACCOUNT_JSON_BASE64=               # base64 of the service account JSON

# --- Observability ---
SENTRY_DSN=

# --- Worker tuning ---
ARQ_WORKERS=4
SOLVER_MAX_CONCURRENT=16

# --- Misc ---
LATEX_ENGINE=pdflatex
MAINTENANCE_MODE=false
MOBILE_DISABLED=false
